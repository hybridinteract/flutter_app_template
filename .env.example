# ================================================================
# ENVIRONMENT CONFIGURATION (example, committed)
# ================================================================
# Copy to `.env` (git-ignored) and adjust: cp .env.example .env
# Values are compiled into the app via --dart-define-from-file, so never
# put real secrets here: anything in the app binary can be extracted.
# Easily switch environments by commenting / uncommenting below:

# ─── 0. LOCAL INFLUEN BACKEND (Default Active) ──────────────────
# The FastAPI backend serves every route under /api/v1 (settings.API_V1_PREFIX).
# Android Emulator uses 10.0.2.2 to reach the host machine's localhost:
BASE_URL=http://10.0.2.2:8000/api/v1
# iOS Simulator / Desktop uses localhost:
# BASE_URL=http://localhost:8000/api/v1
# Physical device: use your PC's LAN IP (same Wi-Fi), e.g.
# BASE_URL=http://192.168.1.10:8000/api/v1
ENABLE_LOGGING=true

# ─── 1. DEVELOPMENT ─────────────────────────────────────────────
# BASE_URL=https://api-dev.example.com/api/v1
# ENABLE_LOGGING=true

# ─── 2. STAGING (Uncomment to switch to Staging) ─────────────────
# BASE_URL=https://api-staging.example.com/api/v1
# ENABLE_LOGGING=true

# ─── 3. PRODUCTION (Uncomment to switch to Production) ──────────
# BASE_URL=https://api.example.com/api/v1
# ENABLE_LOGGING=false
